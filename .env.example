# Copy this file to ".env.local" and fill in real values. Never commit ".env.local".

# PayPal: "sandbox" for testing, "live" for production.
PAYPAL_ENV=sandbox
# PayPal Client ID (safe to expose to the browser; used by the PayPal button).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PayPal Secret (server-only — keep private).
PAYPAL_CLIENT_SECRET=
# PayPal webhook ID (added when the webhook is registered).
PAYPAL_WEBHOOK_ID=

# Public base URL of the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend transactional email (server-only). Verified domain required to send.
RESEND_API_KEY=
# Optional: override the default "Hanox <info@hanox-baumaschinen.de>" sender.
EMAIL_FROM=

# MongoDB Atlas (server-only). Connection string + database name.
MONGODB_URI=
MONGODB_DB=Hanox
# Admin orders view secret (open /admin with this token). Use a long random value.
ADMIN_TOKEN=
