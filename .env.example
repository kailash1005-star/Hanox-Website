# Copy this file to ".env.local" and fill in real values. Never commit ".env.local".

# PayPal environment: "sandbox" for testing, "live" for production.
# This PUBLIC var controls BOTH the API base and the on-site "Testmodus" notice
# (the notice hides automatically when set to "live"). Set it in BOTH .env.local
# and Vercel. (Legacy server-only PAYPAL_ENV still works as a fallback.)
NEXT_PUBLIC_PAYPAL_ENV=sandbox
# PayPal Client ID (safe to expose to the browser; used by the PayPal button).
# Must be the LIVE client id when NEXT_PUBLIC_PAYPAL_ENV=live.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PayPal Secret (server-only — keep private).
PAYPAL_CLIENT_SECRET=
# PayPal webhook ID (added when the webhook is registered).
PAYPAL_WEBHOOK_ID=

# Public base URL of the site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (MongoDB Atlas) — server-only secrets ---
# Connection string from Atlas (Database → Connect → Drivers).
MONGODB_URI=
# Database name to use.
MONGODB_DB=Hanox

# --- Admin orders view ---
# Shared secret to open /admin and call /api/admin/orders. Use a long random value.
ADMIN_TOKEN=

# --- Email (Resend) — server-only ---
RESEND_API_KEY=
# Verified sender + internal notification inbox (optional; sensible defaults exist).
EMAIL_FROM=
ORDER_NOTIFY_TO=
